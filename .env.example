# Copy this file to .env and fill in real values. Never commit .env.

# --- SMTP / email alerts ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
# Comma-separated list of alert recipients
ALERT_RECIPIENTS=isvaryalaxmi.m@euroland.com

# --- Daily status email (optional) ---
# Once a day, the first run at or after STATUS_SEND_AFTER_IST emails a summary
# of that day's runs ("all clear" / "check needed") to this short list only --
# not to ALERT_RECIPIENTS. If it stops arriving, the runs have stopped.
# Leave empty to turn it off.
STATUS_RECIPIENTS=
STATUS_SEND_AFTER_IST=18:00
# Fewer runs than this in a day makes the status "check needed".
EXPECTED_RUNS_PER_DAY=3

# --- Paths (defaults usually fine) ---
COMPANIES_FILE=companies.xlsx
STATE_FILE=state/seen.json
LOG_FILE=logs/whistler.log

# --- Dashboard login (required -- the dashboard refuses to start without these) ---
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Generated automatically on first run if left blank; do not set by hand.
FLASK_SECRET_KEY=
# 127.0.0.1 = this machine only (default). Set to 0.0.0.0 only when you
# deliberately want the dashboard reachable from other devices on your
# network -- the login above is what makes that safe to do.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5057
