[Unit]
Description=Run Financial Whistler 3x/day (matches the Mac's launchd schedule)

[Timer]
# Same wall-clock times as the GitHub Actions schedule (12:37, 15:37,
# 18:37 IST -- timed around the Saudi Exchange trading day, 10:00-15:00
# AST/UTC+3), written here in UTC explicitly so it's correct regardless
# of the server's configured timezone: IST is UTC+5:30, so 12:37/15:37/
# 18:37 IST = 07:07/10:07/13:07 UTC.
OnCalendar=*-*-* 07:07:00 UTC
OnCalendar=*-*-* 10:07:00 UTC
OnCalendar=*-*-* 13:07:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
